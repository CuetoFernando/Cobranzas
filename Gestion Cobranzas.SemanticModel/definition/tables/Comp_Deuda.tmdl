	column Plazo_Vancimiento =
			
			IF(RELATED(Instituciones[Pzo_Pago.Plazos ])<>BLANK(),RELATED(Instituciones[Pzo_Pago.Plazos ]), 45)
		formatString: 0
		lineageTag: 62cf0006-7aec-42a4-a975-7c8bb99dbe22
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Vto_Comp =
			
			CALCULATE(
			    MIN(Comp_Deuda[Fecha emisión]),
			    ALLEXCEPT(Comp_Deuda, Comp_Deuda[Comprobante])
			)+Comp_Deuda[Plazo_Vancimiento]+5
		formatString: Short Date
		lineageTag: 231fc54f-b1f2-4cc9-a978-4bba6e0cdc65
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Dias_Vdo =
			
			IF ((TODAY()-Comp_Deuda[Vto_Comp])<0, "No Vencido", format((TODAY()-Comp_Deuda[Vto_Comp]), "general number"))
		dataType: string
		lineageTag: 89ecd0f2-d0cf-4933-9cf1-f8d21c0b90fe
		summarizeBy: none

