	partition Comp_Deuda = m
		mode: import
		source = ```
				let
				    // 1. Cargar archivo
				    Origen = Csv.Document(File.Contents("H:\Mi unidad\Proyectos Compartidos\Gestion de Cobranzas\Comp_Deuda\COMPOSICIÓN DE DEUDA DE INSTITUCIONES20250521091807.TXT"),[Delimiter=":", Columns=1, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Filas filtradas" = Table.SelectRows(Origen, each ([Column1] <> "" and [Column1] <> "-------------------------------------------------------------------------------------------------------")),
				 
				    TablaIndex = Table.AddIndexColumn(#"Filas filtradas", "Index", 0, 1, Int64.Type),
				
				    // 4. Detectar instituciones
				    AgregarInstitucion = Table.AddColumn(TablaIndex, "Cod Institucion", each if (Text.StartsWith([Column1], "FACT") or Text.StartsWith([Column1], "ORIG"))  then Text.Middle([Column1], 5, Text.PositionOfAny(Text.Middle([Column1], 5), {" ", "("})) else null),
				    AgregarNombre = Table.AddColumn(AgregarInstitucion, "Institucion", each if Text.StartsWith([Column1], "FACT") then Text.BetweenDelimiters([Column1], "(", ")") else null),
				    LlenarInstitucion = Table.FillDown(AgregarNombre, {"Cod Institucion", "Institucion"}),
				    // 5. Filtrar líneas con comprobantes o movimientos asociados
				    FiltrarLineas = Table.SelectRows(LlenarInstitucion, each 
				        Text.StartsWith(Text.Trim([Column1]), "B ") or 
				        Text.StartsWith(Text.Trim([Column1]), "A ") or 
				        Text.StartsWith(Text.Trim([Column1]), "N/C") or 
				        Text.StartsWith(Text.Trim([Column1]), "N/D") or 
				        Text.StartsWith(Text.Trim([Column1]), "PAGO") or 
				        Text.StartsWith(Text.Trim([Column1]), "AJUSTE") or 
				        Text.StartsWith(Text.Trim([Column1]), "DEVOLUCION")
				    ),
				    // 6. Marcar comprobantes principales
				    MarcarPrincipal = Table.AddColumn(FiltrarLineas, "EsPrincipal", each Text.StartsWith(Text.Trim([Column1]), "B ") or Text.StartsWith(Text.Trim([Column1]), "A ")),
				
				    // 7. Extraer comprobante principal
				    ExtraerComp = Table.AddColumn(MarcarPrincipal, "Comprobante", each if [EsPrincipal] then Text.Start(Text.Trim([Column1]), 24) else null),
				    RellenarComp = Table.FillDown(ExtraerComp, {"Comprobante"}),
				    // 8. Extraer asociado
				    Asociado = Table.AddColumn(RellenarComp, "Comp Asociado", each if [EsPrincipal] then "" else Text.Start(Text.Trim([Column1]), 22)),
				    // 9. Extraer campos
				    Fecha = Table.AddColumn(Asociado, "Fecha emisión", each Text.Trim(Text.Middle([Column1], Text.Length([Column1]) - 73, 10))),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Fecha,{{"Fecha emisión", type date}}),
				    Hon = Table.AddColumn(#"Tipo cambiado", "Hon", each Text.Trim(Text.Middle([Column1], Text.Length([Column1]) - 63, 13))),
				    #"Tipo cambiado1" = Table.TransformColumnTypes(Hon,{{"Hon", type number}}),
				    Gastos = Table.AddColumn(#"Tipo cambiado1", "Gastos", each Text.Trim(Text.Middle([Column1], Text.Length([Column1]) - 50, 13))),
				    #"Tipo cambiado2" = Table.TransformColumnTypes(Gastos,{{"Gastos", type number}}),
				    Impuestos = Table.AddColumn(#"Tipo cambiado2", "Impuestos", each Text.Trim(Text.Middle([Column1], Text.Length([Column1]) - 37, 12))),
				    #"Tipo cambiado3" = Table.TransformColumnTypes(Impuestos,{{"Impuestos", type number}}),
				    Total = Table.AddColumn(#"Tipo cambiado3", "Total", each Text.Trim(Text.Middle([Column1], Text.Length([Column1]) - 26, 13))),
				    #"Tipo cambiado4" = Table.TransformColumnTypes(Total,{{"Total", type number}, {"Cod Institucion", Int64.Type}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado4",{"Column1", "Index", "EsPrincipal"}),
				    #"Personalizada agregada" = Table.AddColumn(#"Columnas quitadas", "Total_aj", each if [Total]>0 and Text.StartsWith([Comp Asociado], "N/C") then [Total]*-1 else 
				if [Total]>0 and Text.StartsWith([Comp Asociado], "PAGO") then [Total]*-1 else[Total]),
				    #"Tipo cambiado5" = Table.TransformColumnTypes(#"Personalizada agregada",{{"Total_aj", type number}})
				in
				    #"Tipo cambiado5"
				```

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

